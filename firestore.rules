rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInVerified() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function activeUser() {
      return signedInVerified()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (!('isBanned' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBanned != true);
    }

    function adminUser() {
      return activeUser()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function validText(value, maximum) {
      return value is string && value.size() > 0 && value.size() <= maximum;
    }

    match /users/{userId} {
      allow get: if signedInVerified() && request.auth.uid == userId || adminUser();
      allow list: if adminUser();
      allow create: if signedInVerified()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'photoURL', 'createdAt'])
        && request.resource.data.keys().hasAll(['displayName', 'email', 'photoURL', 'createdAt'])
        && validText(request.resource.data.displayName, 80)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 2048
        && request.resource.data.createdAt == request.time;
      allow update: if signedInVerified() && (
        (request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL'])
          && validText(request.resource.data.displayName, 80)
          && request.resource.data.photoURL is string
          && request.resource.data.photoURL.size() <= 2048)
        || (adminUser()
          && request.auth.uid != userId
          && (!('isAdmin' in resource.data) || resource.data.isAdmin != true)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isBanned'])
          && request.resource.data.isBanned is bool)
      );
      allow delete: if false;

      match /events/{eventId} {
        allow read: if activeUser() && (request.auth.uid == userId || adminUser());
        allow create: if activeUser()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['action', 'module', 'title', 'language', 'characterCount', 'createdAt'])
          && request.resource.data.keys().hasAll(['action', 'module', 'title', 'characterCount', 'createdAt'])
          && request.resource.data.action in ['explain', 'flowchart', 'debug', 'translate', 'complexity', 'Document analyzed', 'Ask document']
          && request.resource.data.module in ['code', 'study']
          && validText(request.resource.data.title, 200)
          && request.resource.data.characterCount is int
          && request.resource.data.characterCount >= 0
          && request.resource.data.characterCount <= 100000
          && (!('language' in request.resource.data) || request.resource.data.language in ['Python', 'JavaScript', 'C++', 'Rust'])
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /quizAttempts/{attemptId} {
        allow read: if activeUser() && (request.auth.uid == userId || adminUser());
        allow create: if activeUser()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['title', 'correct', 'total', 'createdAt'])
          && request.resource.data.keys().hasAll(['title', 'correct', 'total', 'createdAt'])
          && validText(request.resource.data.title, 200)
          && request.resource.data.correct is int
          && request.resource.data.total is int
          && request.resource.data.total > 0
          && request.resource.data.correct >= 0
          && request.resource.data.correct <= request.resource.data.total
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /rooms/{roomId} {
      allow get: if activeUser() && (adminUser() || resource.data.isActive == true);
      allow list: if activeUser() && resource.data.isActive == true;
      allow create: if activeUser()
        && request.resource.data.keys().hasOnly(['name', 'createdBy', 'memberIds', 'memberNames', 'isActive', 'createdAt'])
        && validText(request.resource.data.name, 80)
        && request.resource.data.name.size() >= 3
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.memberNames.keys().hasOnly([request.auth.uid])
        && request.resource.data.memberNames.keys().hasAll([request.auth.uid])
        && validText(request.resource.data.memberNames[request.auth.uid], 80)
        && request.resource.data.isActive == true
        && request.resource.data.createdAt == request.time;
      allow update: if activeUser() && (
        (adminUser()
          && resource.data.isActive == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isActive'])
          && request.resource.data.isActive == false)
        || (resource.data.isActive == true
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'memberNames'])
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly([request.auth.uid])
          && validText(request.resource.data.memberNames[request.auth.uid], 80))
      );
      allow delete: if false;

      match /board/{boardId} {
        function activeRoomMember() {
          return activeUser()
            && get(/databases/$(database)/documents/rooms/$(roomId)).data.isActive == true
            && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberIds;
        }
        allow get: if boardId == 'shared' && activeRoomMember();
        allow list: if false;
        allow create, update: if boardId == 'shared'
          && activeRoomMember()
          && request.resource.data.keys().hasOnly(['content', 'updatedBy', 'updatedAt'])
          && request.resource.data.keys().hasAll(['content', 'updatedBy', 'updatedAt'])
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 10000
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      match /messages/{messageId} {
        function activeRoomMember() {
          return activeUser()
            && get(/databases/$(database)/documents/rooms/$(roomId)).data.isActive == true
            && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberIds;
        }
        allow read: if activeRoomMember();
        allow create: if activeRoomMember()
          && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'text', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName == get(/databases/$(database)/documents/rooms/$(roomId)).data.memberNames[request.auth.uid]
          && validText(request.resource.data.text, 2000)
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /reports/{reportId} {
      allow create: if activeUser()
        && request.resource.data.keys().hasOnly(['category', 'description', 'roomId', 'targetUserId', 'reporterUid', 'reporterEmail', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['category', 'description', 'reporterUid', 'reporterEmail', 'status', 'createdAt'])
        && request.resource.data.category in ['bug', 'abuse', 'content']
        && validText(request.resource.data.description, 2000)
        && request.resource.data.description.size() >= 10
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reporterEmail == request.auth.token.email
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && (!('roomId' in request.resource.data) || validText(request.resource.data.roomId, 150))
        && (!('targetUserId' in request.resource.data) || validText(request.resource.data.targetUserId, 128));
      allow get, list: if adminUser();
      allow update: if adminUser()
        && resource.data.status in ['open', 'processing']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'moderationAction', 'moderationNote', 'moderatedBy', 'updatedAt'])
        && request.resource.data.keys().hasAll(['status', 'moderationAction', 'moderationNote', 'moderatedBy', 'updatedAt'])
        && request.resource.data.status == 'resolved'
        && request.resource.data.moderationAction in ['resolve', 'close-room', 'ban-user']
        && request.resource.data.moderationNote is string
        && request.resource.data.moderationNote.size() <= 500
        && request.resource.data.moderatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

  }
}
